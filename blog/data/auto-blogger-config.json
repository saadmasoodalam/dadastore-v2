{
  "schema_version": 1,
  "module": "dadastore-controlled-auto-blogger",
  "enabled": false,
  "operating_mode": "draft_only",
  "architecture_status": "planned_not_implemented",
  "core_laws": [
    "Auto writing is not auto publishing.",
    "Research support is not source verification.",
    "Draft generation is not editorial approval.",
    "Automated QA is not factual approval.",
    "Owner approval is required before any publication command.",
    "A failed gate stops the batch."
  ],
  "production_sources": {
    "publication_registry": "blog/data/posts.json",
    "taxonomy": "blog/data/categories.json",
    "article_template": "blog/post-template.html",
    "editorial_rules": "blog/data/editorial-rules.json",
    "sitemap": "blog/sitemap.xml",
    "feed": "blog/feed.xml",
    "featured_rotation": "blog/data/featured-rotation.json"
  },
  "planning_contracts": {
    "topic_queue_seed": "blog/data/topic-queue.json",
    "article_brief_schema": "blog/data/article-brief-schema.json"
  },
  "batch_controls": {
    "default_size": 5,
    "maximum_size": 10,
    "minimum_size": 1,
    "one_active_batch_at_a_time": true,
    "batch_id_pattern": "^batch-(?:[0-9]{3}|[0-9]{8}-[a-z0-9]{4,12})$",
    "draft_id_pattern": "^draft-[a-z0-9][a-z0-9-]{2,80}-v[0-9]{2}$",
    "stop_after_batch": true,
    "next_batch_requires_previous_decision": true,
    "allowed_previous_decisions": [
      "approved",
      "rejected",
      "archived"
    ]
  },
  "topic_statuses": [
    "proposed",
    "under_review",
    "approved_for_brief",
    "rejected",
    "brief_generated",
    "draft_generated",
    "editorial_review",
    "approved_for_publication",
    "published",
    "archived"
  ],
  "pipeline": [
    {
      "stage": "topic_queue",
      "automated": false,
      "output": "traceable topic record",
      "gate": "topic record is complete"
    },
    {
      "stage": "topic_validation",
      "automated": true,
      "output": "validation findings",
      "gate": "required fields and taxonomy are valid"
    },
    {
      "stage": "duplicate_search_intent_check",
      "automated": true,
      "output": "overlap score and duplicate-risk decision",
      "gate": "no rejection condition and manual flags resolved"
    },
    {
      "stage": "article_brief",
      "automated": true,
      "output": "schema-valid draft brief",
      "gate": "brief approved by an owner or assigned reviewer"
    },
    {
      "stage": "draft_generation",
      "automated": true,
      "output": "non-public draft files",
      "gate": "draft remains isolated from the Pages source"
    },
    {
      "stage": "automated_editorial_qa",
      "automated": true,
      "output": "quality score and blocking findings",
      "gate": "editorial-review threshold and mandatory sub-scores pass"
    },
    {
      "stage": "asset_and_link_planning",
      "automated": true,
      "output": "cover brief, diagram concept, and link recommendations",
      "gate": "concept uniqueness and public-target validity pass"
    },
    {
      "stage": "owner_review",
      "automated": false,
      "output": "recorded owner decision",
      "gate": "explicit approval for publication"
    },
    {
      "stage": "controlled_publication",
      "automated": false,
      "implemented": false,
      "output": "published article and publication report",
      "gate": "explicit future publication command succeeds"
    }
  ],
  "draft_isolation": {
    "production_pages_source": "main:/",
    "committed_queue_seed_must_remain_empty": true,
    "operational_queue_location": "private non-Pages editorial workspace",
    "operational_draft_root": "content/drafts/<batch-id>/<draft-id>/",
    "allowed_on_pages_branch": false,
    "allowed_in_public_pull_request": false,
    "public_preview_allowed": false,
    "required_exclusions": [
      "blog/index.html",
      "blog/category/index.html",
      "blog/sitemap.xml",
      "blog/feed.xml",
      "blog/data/posts.json",
      "blog/data/featured-rotation.json",
      "Related Articles",
      "public navigation",
      "production article counts"
    ]
  },
  "quality_scoring": {
    "maximum_score": 100,
    "minimum_for_editorial_review": 75,
    "minimum_for_owner_approval_consideration": 85,
    "owner_approval_is_never_automatic": true,
    "automatic_rejection_overrides_score": true,
    "rules_source": "blog/data/editorial-rules.json"
  },
  "duplicate_protection": {
    "overlap_score_scale": "0-100",
    "manual_review_minimum": 65,
    "automatic_rejection_minimum": 90,
    "comparison_sources": [
      "titles",
      "slugs",
      "primary keywords",
      "search intent",
      "categories",
      "article summaries",
      "heading outlines",
      "metadata",
      "semantic topic overlap",
      "cover concepts",
      "insight-diagram concepts"
    ]
  },
  "factual_risk_levels": [
    "low",
    "moderate",
    "high"
  ],
  "owner_approval_gate": {
    "required": true,
    "required_checks": [
      "topic approved",
      "brief approved",
      "draft generated",
      "automated QA passed",
      "editorial review completed",
      "owner approval recorded",
      "final metadata approved",
      "final cover approved",
      "final category approved",
      "final internal links approved"
    ],
    "implicit_status_transition_allowed": false
  },
  "publication": {
    "command_implemented": false,
    "automatic_publishing_allowed": false,
    "requires_explicit_command": true,
    "requires_clean_production_worktree": true,
    "stop_on_any_failure": true,
    "requires_publication_report": true,
    "requires_publication_commit": true,
    "requires_rollback_commit_reference": true
  },
  "production_protection": {
    "published_article_mutation_allowed": false,
    "published_slug_overwrite_allowed": false,
    "publication_state_mutation_allowed": false,
    "category_mutation_allowed": false,
    "sitemap_mutation_allowed": false,
    "feed_mutation_allowed": false,
    "featured_rotation_mutation_allowed": false,
    "related_articles_mutation_allowed": false,
    "production_domain_mutation_allowed": false,
    "github_pages_setting_mutation_allowed": false,
    "article_plan_mutation_allowed": false
  },
  "github_actions": {
    "workflow_created": false,
    "future_role": "manual validation and private draft-artifact preparation only",
    "scheduled_generation_allowed": false,
    "pages_permission_allowed": false,
    "deployment_permission_allowed": false,
    "direct_push_to_main_allowed": false,
    "automatic_merge_allowed": false,
    "automatic_publication_allowed": false
  }
}
