{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dadastore:auto-blogger:article-brief:1",
  "title": "DaDaStore Auto Blogger Article Brief",
  "description": "Draft-only article brief contract. A valid brief is not publication approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "brief_id",
    "topic_id",
    "working_title",
    "primary_keyword",
    "secondary_keywords",
    "search_intent",
    "audience_problem",
    "article_promise",
    "category",
    "article_type",
    "target_length_range",
    "heading_outline",
    "required_concepts",
    "prohibited_claims",
    "factual_claims_requiring_sources",
    "examples_required",
    "internal_links",
    "external_source_requirements",
    "cta_objective",
    "insight_diagram_concept",
    "cover_image_concept",
    "related_topic_candidates",
    "tone",
    "originality_requirements",
    "approval_state"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "default": 1
    },
    "brief_id": {
      "type": "string",
      "pattern": "^brief-topic-[0-9]{8}-[a-z0-9]{4,16}-v[0-9]{2}$"
    },
    "topic_id": {
      "type": "string",
      "pattern": "^topic-[0-9]{8}-[a-z0-9]{4,16}$"
    },
    "batch_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^batch-[0-9]{8}-[a-z0-9]{4,12}$"
    },
    "draft_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^draft-[a-z0-9][a-z0-9-]{2,80}-v[0-9]{2}$"
    },
    "working_title": {
      "type": "string",
      "minLength": 15,
      "maxLength": 120
    },
    "proposed_slug": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "primary_keyword": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "secondary_keywords": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 100
      },
      "uniqueItems": true,
      "maxItems": 10
    },
    "search_intent": {
      "type": "string",
      "enum": [
        "informational",
        "commercial investigation",
        "problem-solving"
      ]
    },
    "audience_problem": {
      "type": "string",
      "minLength": 30,
      "maxLength": 800
    },
    "article_promise": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400
    },
    "category": {
      "type": "string",
      "enum": [
        "Paid Media",
        "Social Media Strategy",
        "Ecommerce & CRO",
        "Tracking & Analytics",
        "Creative Strategy",
        "Marketing Automation",
        "Content Marketing",
        "SEO",
        "Email Marketing",
        "Business Growth Systems"
      ]
    },
    "article_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "target_length_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_words",
        "maximum_words"
      ],
      "properties": {
        "minimum_words": {
          "type": "integer",
          "minimum": 800,
          "maximum": 3000
        },
        "maximum_words": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 3500
        }
      }
    },
    "heading_outline": {
      "type": "array",
      "minItems": 4,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "heading",
          "purpose",
          "required_points"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "enum": [
              2,
              3
            ]
          },
          "heading": {
            "type": "string",
            "minLength": 5,
            "maxLength": 120
          },
          "purpose": {
            "type": "string",
            "minLength": 10,
            "maxLength": 400
          },
          "required_points": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 250
            }
          }
        }
      }
    },
    "required_concepts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 250
      }
    },
    "prohibited_claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 250
      }
    },
    "factual_claims_requiring_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_or_question",
          "risk_level",
          "required_source_types",
          "time_sensitive"
        ],
        "properties": {
          "claim_or_question": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "risk_level": {
            "type": "string",
            "enum": [
              "low",
              "moderate",
              "high"
            ]
          },
          "required_source_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "user-provided material",
                "official documentation",
                "research paper",
                "reputable industry source"
              ]
            }
          },
          "time_sensitive": {
            "type": "boolean"
          }
        }
      }
    },
    "examples_required": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "example_type",
          "must_be_synthetic"
        ],
        "properties": {
          "purpose": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          },
          "example_type": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          },
          "must_be_synthetic": {
            "type": "boolean",
            "const": true
          }
        }
      }
    },
    "internal_links": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_slug",
          "anchor_intent",
          "editorial_reason",
          "target_must_be_published"
        ],
        "properties": {
          "target_slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "anchor_intent": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "editorial_reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          },
          "target_must_be_published": {
            "type": "boolean",
            "const": true
          }
        }
      }
    },
    "external_source_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_type",
          "research_question",
          "primary_source_preferred",
          "review_required"
        ],
        "properties": {
          "source_type": {
            "type": "string",
            "enum": [
              "user-provided material",
              "official documentation",
              "research paper",
              "reputable industry source"
            ]
          },
          "research_question": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "primary_source_preferred": {
            "type": "boolean"
          },
          "review_required": {
            "type": "boolean",
            "const": true
          }
        }
      }
    },
    "cta_objective": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "insight_diagram_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_name",
        "semantic_family",
        "explanatory_purpose",
        "required_labels",
        "caption_draft",
        "accessibility_summary",
        "uniqueness_notes"
      ],
      "properties": {
        "concept_name": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "semantic_family": {
          "type": "string",
          "enum": [
            "comparison-diagram",
            "process-flow",
            "decision-framework",
            "measurement-system",
            "layered-architecture"
          ]
        },
        "explanatory_purpose": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "required_labels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        },
        "caption_draft": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300
        },
        "accessibility_summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        },
        "uniqueness_notes": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        }
      }
    },
    "cover_image_concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept_name",
        "composition",
        "visual_keywords",
        "brand_direction",
        "width",
        "height",
        "headline_embedded",
        "alt_text_draft",
        "uniqueness_notes"
      ],
      "properties": {
        "concept_name": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "composition": {
          "type": "string",
          "minLength": 20,
          "maxLength": 600
        },
        "visual_keywords": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          }
        },
        "brand_direction": {
          "type": "string",
          "minLength": 20,
          "maxLength": 400
        },
        "width": {
          "type": "integer",
          "const": 1280
        },
        "height": {
          "type": "integer",
          "const": 720
        },
        "headline_embedded": {
          "type": "boolean",
          "const": false
        },
        "alt_text_draft": {
          "type": "string",
          "minLength": 20,
          "maxLength": 240
        },
        "uniqueness_notes": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500
        }
      }
    },
    "related_topic_candidates": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "tone": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "practical",
          "intelligent",
          "direct",
          "measured",
          "professional",
          "evidence-aware"
        ]
      }
    },
    "originality_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distinct_search_intent",
        "distinct_introduction",
        "distinct_conclusion",
        "distinct_cover_concept",
        "distinct_diagram_concept",
        "maximum_existing_topic_overlap_score"
      ],
      "properties": {
        "distinct_search_intent": {
          "type": "boolean",
          "const": true
        },
        "distinct_introduction": {
          "type": "boolean",
          "const": true
        },
        "distinct_conclusion": {
          "type": "boolean",
          "const": true
        },
        "distinct_cover_concept": {
          "type": "boolean",
          "const": true
        },
        "distinct_diagram_concept": {
          "type": "boolean",
          "const": true
        },
        "maximum_existing_topic_overlap_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 89
        }
      }
    },
    "approval_state": {
      "type": "string",
      "enum": [
        "draft",
        "under_review",
        "approved",
        "rejected",
        "archived"
      ]
    },
    "approval_record": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "decision",
        "reviewed_at",
        "reviewed_by",
        "notes"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "approved",
            "rejected"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "reviewed_by": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
